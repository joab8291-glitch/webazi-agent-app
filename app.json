{
  "expo": {
    "name": "Webazi",
    "slug": "webazi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/webazi_profile_photo.png",
    "scheme": "webaziussdapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.webazi.ussdapp"
    },
    "android": {
      "package": "com.webazi.agentapp",
      "adaptiveIcon": {
        "backgroundColor": "#00A86B",
        "foregroundImage": "./assets/images/webazi_profile_photo.png",
        "backgroundImage": "./assets/images/webazi_profile_photo.png",
        "monochromeImage": "./assets/images/webazi_profile_photo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS",
        "SEND_SMS",
        "READ_PHONE_STATE",
        "READ_PHONE_NUMBERS",
        "CALL_PHONE",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS",
        "BIND_ACCESSIBILITY_SERVICE",
        "SYSTEM_ALERT_WINDOW",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-contacts",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/webazi_profile_photo.png",
          "color": "#FF3B30",
          "defaultChannel": "webazi_float_alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/webazi_profile_photo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00A86B",
          "dark": {
            "backgroundColor": "#0B1F17"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59ca212e-2253-4b69-9d60-40655d591c83"
      }
    },
    "owner": "webazi-agent-app"
  }
}
