<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for making USSD calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Required for SIM/subscription information -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Required to access PhoneAccount information on modern Android -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Required to keep the screen on during a multi-step USSD dial -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>

        <!-- Accessibility Service -->
        <service
            android:name=".UssdAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="Webazi USSD Accessibility Service">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />

        </service>

    </application>

</manifest>
