<?xml version="1.0" encoding="utf-8"?>
<!--
  No android:packageNames filter here on purpose.

  The USSD response/menu dialog is a system-level AlertDialog. Which
  package actually renders it (com.android.phone, the OEM dialer
  package such as com.google.android.dialer / com.android.dialer, or
  the "android" system package) varies by manufacturer and Android
  version — restricting to "com.android.phone" caused the service to
  never see the dialog at all on devices where it's shown by a
  different package: no onAccessibilityEvent ever fired, onResult was
  never invoked, the JS side hung forever on "Confirming via USSD…",
  and the dialog was left on screen for the person to dismiss by hand.

  Listening package-wide is safe here because onAccessibilityEvent
  already no-ops immediately unless requestActive is true (set only
  for the duration of a deliberate dial() call started by this app),
  so this doesn't turn into a general-purpose screen reader.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100" />